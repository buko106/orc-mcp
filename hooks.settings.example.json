{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc-mcp-hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "orc-mcp-hook stop-wait",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
