{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/orc-mcp/dist/src/hook.js session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /ABSOLUTE/PATH/TO/orc-mcp/dist/src/hook.js stop-wait",
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
