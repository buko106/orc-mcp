{
  "name": "orc-mcp",
  "version": "0.0.0-development",
  "description": "Local MCP orchestrator that coordinates multiple Claude Code sessions (one repo each)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buko106/orc-mcp.git"
  },
  "bin": {
    "orc-mcp": "dist/src/index.js",
    "orc-mcp-hook": "dist/src/hook.js"
  },
  "files": [
    "dist/src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsx test/smoke.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
